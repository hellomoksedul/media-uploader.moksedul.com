{
  "name": "@hellomoksedul/media-uploader",
  "version": "1.0.4",
  "private": false,
  "description": "A fully customizable, headless media upload library for React & Next.js. Includes image editor, cropper, filters, Unsplash integration and 4 field variants.",
  "author": "Moksedul Islam <hello@moksedul.com>",
  "license": "MIT",
  "homepage": "https://media-uploader.moksedul.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellomoksedul/media-uploader.moksedul.com.git"
  },
  "bugs": {
    "url": "https://github.com/hellomoksedul/media-uploader.moksedul.com/issues"
  },
  "keywords": [
    "media-uploader",
    "image-upload",
    "image-editor",
    "image-cropper",
    "file-upload",
    "react",
    "nextjs",
    "tailwindcss",
    "unsplash",
    "headless"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-styles.js && tsup src/index.ts --format cjs,esm --dts",
    "dev": "node scripts/build-styles.js && tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.0.0",
    "react-advanced-cropper": "^0.20.1",
    "react-icons": "^5.7.0",
    "react-mobile-cropper": "^0.10.1",
    "shadcn": "^4.16.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
